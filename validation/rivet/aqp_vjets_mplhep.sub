# One low-memory AQP mplhep plot job. Files stay on shared /data.
universe = vanilla
initialdir = /home/aalida/AQP/validation/rivet
executable = /bin/bash
arguments = /home/aalida/AQP/validation/rivet/aqp_vjets_mplhep_worker.sh
getenv = True
should_transfer_files = YES
transfer_executable = False
when_to_transfer_output = ON_EXIT
transfer_output_files = ""
request_cpus = 1
request_memory = 4000
request_disk = 3000000
output = /home/aalida/AQP/validation/rivet/condor_logs/vjets_mplhep.$(Cluster).out
error = /home/aalida/AQP/validation/rivet/condor_logs/vjets_mplhep.$(Cluster).err
log = /home/aalida/AQP/validation/rivet/condor_logs/vjets_mplhep.$(Cluster).condor.log
queue 1
