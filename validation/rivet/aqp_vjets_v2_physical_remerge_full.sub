# Full, non-destructive physical-XS metadata remerge of five v2 samples.
# Submit from ~/AQP/validation/rivet after mkdir -p condor_logs
# The matched JSON is read from /home/aalida/AQP/v2_log_yoda_xsec_match_FULL.json.
# Original YODA files and the earlier two-file pilot are not overwritten.
universe = vanilla
executable = /bin/bash
arguments = aqp_vjets_v2_physical_remerge_worker.sh $(sample) 0
transfer_input_files = aqp_vjets_v2_physical_remerge_worker.sh,aqp_vjets_v2_physical_remerge.py,aqp_vjets_physics_preflight.py,aqp_vjets_xsec_per_file.py
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
getenv = True
request_cpus = 1
request_memory = 8000
request_disk = 4000000
output = condor_logs/v2xsec_full.$(ClusterId).$(ProcId).out
error = condor_logs/v2xsec_full.$(ClusterId).$(ProcId).err
log = condor_logs/v2xsec_full.$(ClusterId).$(ProcId).condor.log
queue sample from (
Zee/standard111/v2
Zee/delta111/v2
Zee/delta221/v2
Wenu/delta111/v2
Wenu/delta221/v2
)
