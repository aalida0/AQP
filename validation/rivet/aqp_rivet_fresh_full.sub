# 8 configurations x 32 deterministic shards; manifest must already exist.
# Submit from ~/AQP/validation/rivet after mkdir -p condor_logs.
universe = vanilla
executable = /bin/bash
arguments = aqp_rivet_fresh_full_worker.sh $(sample) $(shard)
transfer_input_files = aqp_rivet_fresh_full_worker.sh,aqp_rivet_fresh_full.py,aqp_rivet_fresh_pilot.py,aqp_rivet_fresh_evnt_job.py,aqp_rivet_stream.py,aqp_vjets_generator_xsec_evidence.py,aqp_vjets_v2_xsec_match.py,aqp_vjets_physics_preflight.py,aqp_vjets_xsec_per_file.py
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
getenv = True
request_cpus = 1
request_memory = 6000
request_disk = 8000000
output = condor_logs/fresh_full.$(ClusterId).$(ProcId).out
error = condor_logs/fresh_full.$(ClusterId).$(ProcId).err
log = condor_logs/fresh_full.$(ClusterId).$(ProcId).condor.log
