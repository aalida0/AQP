# Submit from ~/AQP/validation/rivet (located under /home, not Ceph).
# Create condor_logs/ in this directory first.
# ONLY physics YODA output is written to /data; HTCondor logs stay in /home.
# No filesystem-domain requirements, no Ceph submit logs.
universe = vanilla
executable = /bin/bash
arguments = aqp_vjets_remerge_wenu_d441_worker.sh
transfer_input_files = aqp_vjets_remerge_wenu_d441_worker.sh,aqp_vjets_remerge_wenu_d441.py,aqp_vjets_xsec_per_file.py,aqp_vjets_physics_preflight.py
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
getenv = True
request_cpus = 1
request_memory = 8000
request_disk = 4000000
output = condor_logs/Wenu_D441.$(ClusterId).out
error = condor_logs/Wenu_D441.$(ClusterId).err
log = condor_logs/Wenu_D441.$(ClusterId).condor.log
queue
