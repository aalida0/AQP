# Eight configurations x eight independent file shards = 64 Condor jobs.
# The 8 shards cover ALL currently available EVNT files, not 2M.
universe = vanilla
executable = aqp_rivet_condor_worker.sh
arguments = $(Proc) $(Cfg) $(Shard) 8
transfer_executable = True
transfer_input_files = aqp_rivet_stream.py,aqp_rivet_evnt_job.py
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
getenv = True
# If Rucio uses X.509, configure proxy forwarding with the AF admin docs.
# use_x509userproxy = True
request_cpus = 1
request_memory = 4000
request_disk = 8000000
output = /data/aalida/AQP_Rivet/condor_logs/$(Proc)_$(Cfg)_$(Shard).out
error  = /data/aalida/AQP_Rivet/condor_logs/$(Proc)_$(Cfg)_$(Shard).err
log    = /data/aalida/AQP_Rivet/condor_logs/$(Proc)_$(Cfg)_$(Shard).condor.log
queue Proc,Cfg,Shard from (
  Zee standard111 0
  Zee standard111 1
  Zee standard111 2
  Zee standard111 3
  Zee standard111 4
  Zee standard111 5
  Zee standard111 6
  Zee standard111 7
  Zee delta111 0
  Zee delta111 1
  Zee delta111 2
  Zee delta111 3
  Zee delta111 4
  Zee delta111 5
  Zee delta111 6
  Zee delta111 7
  Zee delta221 0
  Zee delta221 1
  Zee delta221 2
  Zee delta221 3
