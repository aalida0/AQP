# AQP Wenu Standard111 50k LHE (before PR426) -> 18k accepted EVNT
# One outer HTCondor job, NO nested Condor or MadGraph generation.
#
# 2026-10-31: FileSystemDomain mismatch diagnosed on 4059847.0.
# Transfer inputs from temporary /home staging to execute-node scratch,
# then return results to temporary /home. A separate validated finalize step
# archives the large ROOT output to /data and removes the /home copy.
# This avoids AF restrictions on transfer_input_files sourced from Ceph.
#
# Before submitting:
#   condor_rm 4059847.0                         # after verifying still idle
#   mkdir -p .aqp_staged/fxfx_pr426_shower/logs
#   bash scripts/stage_wenu_fxfx_pr426_before_18000_transfer.sh
#   condor_submit condor/wenu_fxfx_pr426_before_18000_shower.submit

universe = vanilla
# Run transferred script with /bin/bash so its GitHub file mode does not
# have to be executable on the submit host.
executable = /bin/bash
arguments = run_wenu_fxfx_pr426_condor_transfer.sh before 18000 13311

# AF policy forbids submitting jobs with initialdir on /data.
# Keep the job IWD and lightweight diagnostics on /home.
initialdir = /home/aalida/AQP/aqp-production-audit/.aqp_staged/fxfx_pr426_shower/returned/before_accepted18000_seed13311

should_transfer_files = YES
transfer_executable = False
when_to_transfer_output = ON_EXIT
# The LHE and checksum are short-lived verified copies staged in /home
# by scripts/stage_wenu_fxfx_pr426_before_18000_transfer.sh.
# DO NOT list a /data (Ceph) path here: the AF rejects such submissions.
transfer_input_files = source_50k_lhe.gz,source_50k_lhe.sha256,/home/aalida/AQP/aqp-production-audit/joboptions/wenu_fxfx_pr426_shower/100007,/home/aalida/AQP/aqp-production-audit/scripts/run_wenu_fxfx_pr426_condor_transfer.sh
transfer_output_files = shower_artifacts,wenu_pr426_before_accepted18000.EVNT.pool.root

# All returned files land in /home initialdir. After successful completion
# run scripts/finalize_wenu_fxfx_pr426_before_18000_transfer.sh to checksum,
# copy the large EVNT to /data, and remove temporary /home large files.

# The job only needs Pythia8; does not submit any other jobs.
# Transported EVNT must be nonempty and verified before physics use.
# On failure a zero-byte placeholder may be returned; never finalize it.
request_cpus = 1
request_memory = 8000MB
request_disk = 8000MB

output = /home/aalida/AQP/aqp-production-audit/.aqp_staged/fxfx_pr426_shower/logs/before_18000.$(Cluster).$(Process).out
error = /home/aalida/AQP/aqp-production-audit/.aqp_staged/fxfx_pr426_shower/logs/before_18000.$(Cluster).$(Process).err
log = /home/aalida/AQP/aqp-production-audit/.aqp_staged/fxfx_pr426_shower/logs/before_18000.$(Cluster).$(Process).log
notification = Never
+JobBatchName = "AQP_Wenu_PR426_before_FxFx18k"
queue 1
