# One-core Pythia8 shower job: 50k Standard111 before-PR426 LHE -> 18k EVNT.
# Runs on a Condor worker; NO nested Condor or MadGraph integration.
universe = vanilla
executable = /bin/bash
arguments = /home/aalida/AQP/aqp-production-audit/scripts/run_wenu_fxfx_pr426_shower.sh before 18000 /data/aalida/AQP/Wjets/WENU/fxfx_pr426_standard111_shower/before_accepted200_seed13311/source_50k_lhe.gz
initialdir = /home/aalida/AQP/aqp-production-audit
getenv = True
should_transfer_files = NO
request_cpus = 1
request_memory = 8000MB
request_disk = 30000MB
output = /home/aalida/AQP/aqp-production-audit/.aqp_staged/fxfx_pr426_shower/logs/before_18000.$(Cluster).$(Process).out
error = /home/aalida/AQP/aqp-production-audit/.aqp_staged/fxfx_pr426_shower/logs/before_18000.$(Cluster).$(Process).err
log = /home/aalida/AQP/aqp-production-audit/.aqp_staged/fxfx_pr426_shower/logs/before_18000.$(Cluster).$(Process).log
notification = Never
+JobBatchName = "AQP_Wenu_PR426_before_FxFx18k"
queue 1
