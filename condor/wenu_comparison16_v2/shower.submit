# Isolated Wenu comparison v2, pinned to AQP audit checkout. Submit via DAG only.
# FxFx shower-only of completed Wenu multicore LHE output.
universe = vanilla
executable = /home/aalida/AQP/aqp-production-audit/scripts/run_wenu_comparison_16core_fxfx.sh
arguments = $(CFG) $(SEED) $(NEVENTS) $(TAG)
initialdir = /home/aalida/AQP/aqp-production-audit
getenv = True
should_transfer_files = YES
transfer_executable = True
transfer_input_files = /home/aalida/AQP/aqp-production-audit/joboptions/wenu_comparison16_shower/$(CFG)/100004
when_to_transfer_output = ON_EXIT
transfer_output_files = ""
request_cpus = 1
request_memory = 8000MB
request_disk = 20000MB
output = /home/aalida/AQP/aqp-production-audit/.aqp_staged/wenu_compare16_v2/logs/wenu_cmp_$(TAG)_$(CFG)_fxfx.$(Cluster).out
error = /home/aalida/AQP/aqp-production-audit/.aqp_staged/wenu_compare16_v2/logs/wenu_cmp_$(TAG)_$(CFG)_fxfx.$(Cluster).err
log = /home/aalida/AQP/aqp-production-audit/.aqp_staged/wenu_compare16_v2/logs/wenu_cmp_$(TAG)_$(CFG)_fxfx.$(Cluster).log
notification = Never
queue 1
