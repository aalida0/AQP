# Wenu Standard111 FxFx PR426 smoke200: fresh integration and direct LHE, no gridpacks.
# Two jobs: before and after. Scheduler backend itself is NOT being patched.
universe = vanilla
executable = /home/aalida/AQP/aqp-production-audit/scripts/run_wenu_fxfx_pr426_ab.sh
arguments = $(CASE) 200 311
initialdir = /home/aalida/AQP/aqp-production-audit
getenv = True
should_transfer_files = YES
transfer_executable = True
transfer_input_files = /home/aalida/AQP/aqp-production-audit/joboptions/wenu_fxfx_pr426_ab/$(CASE)/100005,/home/aalida/AQP/aqp-production-audit/scripts/aqp_prepare_fxfx_exclusive_kt_patch.py,/home/aalida/AQP/Wjets/WENU/standard111/100000/dummy_fct.f,/home/aalida/AQP/Wjets/WENU/standard111/100000/montecarlocounter_MINE.f
when_to_transfer_output = ON_EXIT
transfer_output_files = ""
request_cpus = 16
request_memory = 32000MB
request_disk = 100000MB
output = /home/aalida/AQP/aqp-production-audit/.aqp_staged/fxfx_pr426_ab/logs/smoke200_$(CASE).$(Cluster).out
error = /home/aalida/AQP/aqp-production-audit/.aqp_staged/fxfx_pr426_ab/logs/smoke200_$(CASE).$(Cluster).err
log = /home/aalida/AQP/aqp-production-audit/.aqp_staged/fxfx_pr426_ab/logs/smoke200_$(CASE).$(Cluster).log
notification = Never
queue CASE from (
before
after
)
