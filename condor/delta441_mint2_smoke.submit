# One isolated Δ441 MINT2 smoke-test task (no nested Condor).
# Code/JO stored in /home; gridpack/retained results in /data;
# temporary extracted process and all generation executables on worker scratch.

universe = vanilla
executable = /home/aalida/AQP/Wjets/WENU/run_delta441_smoke_condor.sh
arguments =
initialdir = /home/aalida/AQP/Wjets/WENU
getenv = True

should_transfer_files = YES
transfer_executable = True
transfer_input_files = /home/aalida/AQP/Wjets/WENU/smoke_jo/100003
when_to_transfer_output = ON_EXIT
transfer_output_files = ""

# The dedicated event-generation JO uses run_mode=0, nb_core=1.
# Request exactly one CPU; no nested Condor or Athena multicore.
request_cpus = 1
request_memory = 8192MB
request_disk = 45000MB

output = /home/aalida/AQP/Wjets/WENU/packaging_logs/delta441_smoke.$(Cluster).out
error = /home/aalida/AQP/Wjets/WENU/packaging_logs/delta441_smoke.$(Cluster).err
log = /home/aalida/AQP/Wjets/WENU/packaging_logs/delta441_smoke.$(Cluster).log

notification = Never
queue 1
