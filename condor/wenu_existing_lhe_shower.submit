# AQP Wenu 1000-LHE -> up to 200 FxFx EVNT per configuration.
# ONLY existing /home LHE files; no MG gridpack, no MINT and no retries.
# First run scripts/stage_wenu_existing_lhe_shower.sh to pin file SHA256.
universe = vanilla
executable = /home/aalida/AQP/aqp-production-audit/scripts/run_wenu_existing_lhe_shower.sh
arguments = $(CFG) $(SHA)
initialdir = /home/aalida/AQP/aqp-production-audit
getenv = True
should_transfer_files = YES
transfer_executable = True
transfer_input_files = /home/aalida/AQP/aqp-production-audit/joboptions/wenu_existing_lhe_shower/$(CFG)/100004,/home/aalida/AQP/aqp-production-audit/scripts/audit_wenu_delta441_lhe.py
when_to_transfer_output = ON_EXIT
transfer_output_files = ""
request_cpus = 1
request_memory = 8000MB
request_disk = 20000MB
output = /home/aalida/AQP/aqp-production-audit/.aqp_staged/wenu_existing_lhe_shower_v1/$(CFG).$(Cluster).$(Process).out
error = /home/aalida/AQP/aqp-production-audit/.aqp_staged/wenu_existing_lhe_shower_v1/$(CFG).$(Cluster).$(Process).err
log = /home/aalida/AQP/aqp-production-audit/.aqp_staged/wenu_existing_lhe_shower_v1/$(CFG).$(Cluster).$(Process).log
notification = Never
+JobBatchName = "AQP_Wenu_RecoveredLHE_FxFxSmoke"
queue CFG,SHA from /home/aalida/AQP/aqp-production-audit/.aqp_staged/wenu_existing_lhe_shower_v1/source_sha.txt
