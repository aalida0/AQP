# Four independent HTCondor jobs for W+jets MG5_aMC@NLO FxFx archives.
# Scripts: /home/aalida/AQP/Wjets/WENU
# Large source processes & gridpack outputs: /data/aalida/AQP/Wjets/WENU
# No symlinks, no MYFilesystem, no Ceph Condor event logs.
#
# Each configuration is a separate proc in one cluster. Completed LHE
# is required for standard111, delta111, delta221; delta441_backup
# is integration-only with its reconstructed 21-key checkpoint.
#
# Condor transfers ONLY the small packaging script into worker scratch;
# source process directories are accessed through absolute /data paths.

universe = vanilla
executable = /home/aalida/AQP/Wjets/WENU/package_wjets_gridpacks.sh
arguments = $(CFG)

initialdir = /home/aalida/AQP/Wjets/WENU
getenv = True

should_transfer_files = YES
transfer_executable = True
when_to_transfer_output = ON_EXIT
transfer_output_files = ""

environment = "AQP_WENU_HOME=/data/aalida/AQP/Wjets/WENU AQP_WENU_DATA=/data/aalida/AQP/Wjets/WENU/gridpacks"

request_cpus = 1
request_memory = 2048MB
request_disk = 2048MB

output = /home/aalida/AQP/Wjets/WENU/packaging_logs/$(CFG).$(Cluster).$(Process).out
error = /home/aalida/AQP/Wjets/WENU/packaging_logs/$(CFG).$(Cluster).$(Process).err
log = /home/aalida/AQP/Wjets/WENU/packaging_logs/$(CFG).$(Cluster).$(Process).log

notification = Never

queue CFG from (
standard111
delta111
delta221
delta441_backup
)
